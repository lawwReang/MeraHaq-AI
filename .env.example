# GEMINI_API_KEY: Required for Gemini AI API calls.
# Get your API key from: https://ai.google.dev/
# 
# ⚠️  IMPORTANT REQUIREMENTS:
#  - Must start with "AIza"
#  - Must be at least 30 characters long
#  - Must have access to Generative Language API
#  - Must have access to gemini-2.5-flash model
#
# For AI Studio: Automatically injected from user secrets
# For Local Development: Add to HiddenApi.env (ignored in .gitignore)
#
# ❌ Common Issues & Solutions:
#  1. "API Key not found" → Verify key is in environment
#  2. "API_KEY_INVALID" → Check key format (should start with AIza)
#  3. "Permission denied" → Ensure key has Generative Language API enabled
#  4. "Rate limit exceeded" → Wait 1-2 minutes and retry
GEMINI_API_KEY="AIza_YOUR_API_KEY_HERE"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
